"them"}], "selected": 0, "text": "", "id": 2}, {"correct": 0, "_data": [{"type": "text", "content": "hit"}], "selected": 0, "text": "", "id": 3}, {"correct": 0, "_data": [{"type": "text", "content": "some"}], "selected": 0, "text": "", "id": 4}, {"correct": 0, "_data": [{"type": "text", "content": "home"}], "selected": 0, "text": "", "id": 5}, {"correct": 0, "_data": [{"type": "text", "content": "runs"}], "selected": 0, "text": "", "id": 6}, {"correct": 0, "_data": [{"type": "text", "content": "."}], "selected": 0, "text": "", "id": 7}]}, {"_data": [{"type": "question", "contents": [{"type": "text", "content": ""}]}, {"type": "objective", "content": "secondary_1"}], "id": 5, "responses": [{"correct": 0, "_data": [{"type": "text", "content": "We"}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"type": "text", "content": "rode"}], "selected": 0, "id": 1}, {"correct": 0, "_data": [{"type": "text", "content": "up"}], "selected": 0, "text": "", "id": 2}, {"correct": 0, "_data": [{"type": "text", "content": "all"}], "selected": 0, "text": "", "id": 3}, {"correct": 0, "_data": [{"type": "text", "content": "the"}], "selected": 0, "text": "", "id": 4}, {"correct": 0, "_data": [{"type": "text", "content": "hills"}], "selected": 0, "text": "", "id": 5}, {"correct": 0, "_data": [{"type": "text", "content": "on"}], "selected": 0, "text": "", "id": 6}, {"correct": 0, "_data": [{"type": "text", "content": "bikes"}], "selected": 0, "text": "", "id": 7}, {"correct": 0, "_data": [{"type": "text", "content": "."}], "selected": 0, "text": "", "id": 8}]}], "stimuli_ids": [], "id": 11, "type": "SLS", "_data": [{"type": "instructions", "contents": [{"type": "text", "content": "Sally and Peter <span class=\"tool-tip\" id=\"tip_11_0\">crammed</span> a lot into their Boston trip."}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Activity 1"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}]}, {"type": "tips", "content": [{"type": "text", "tip_id": 0, "content": "\u201c<span class=\"italic\">To cram</span>\u201d means to try and fit as much into a schedule or a space as possible."}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Select all the Past tense verbs in each sentence."}, {"type": "text", "content": "You have 2 attempts to submit your answers."}]}], "template_override": 1}], "id": 0, "type": "scholar", "stimuli": [{"_data": [], "template_override": 1, "type": "welcome", "id": 0, "contents": [{}]}, {"id": 1, "type": "audio", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn5le15ob11re2aud01", "coverimg": "engenn5le15ob11re2img06.jpg", "images": [{"text": "", "id": 0, "time": "0", "image": "engenn5le15ob11re2img06.jpg"}, {"text": "<span class=\"strong\">Sally</span>: Hi, Vanessa.<br>\n<span class=\"strong\">Vanessa</span>: Hey, Sally. <br>\n<span class=\"strong\">Sally</span>: I was wondering if we could have coffee.</br>\n<span class=\"strong\">Vanessa</span>: Sure. Let's bum around for a morning. </br>\n<span class=\"strong\">Sally</span>: Yeah. I'd like to tell you about my day in Boston with Peter. </br>\n<span class=\"strong\">Vanessa</span>: Is it OK if we go to my favorite coffee bar? </br>\n<span class=\"strong\">Sally</span>: No problem.", "id": 1, "time": "100", "image": "engenn5le15ob11re2img06.jpg"}, {"text": "<span class=\"strong\">Vanessa</span>: So, tell me about your road trip.</br>\n<span class=\"strong\">Sally</span>: Oh, we crammed in a lot. We took the commuter train, went to a baseball game ...</br>\n<span class=\"strong\">Vanessa</span>: You went to a baseball game?</br>\n<span class=\"strong\">Sally</span>: Yeah, I sat through all the innings, rooted for our home team, and watched them hit some home runs.</br>\n<span class=\"strong\">Vanessa</span>: What were you doing when Peter cheered his lungs out?</br>\n<span class=\"strong\">Sally</span>: I was drinking my beer.", "id": 2, "time": "13000", "image": "engenn5le15ob11re2img01.jpg"}, {"text": "<span class=\"strong\">Vanessa</span>: Did you venture down to the seaside?</br>\n<span class=\"strong\">Sally</span>: Yup. We rode up all the hills on bikes, through the zoo and down to Castle Island Park.</br>\n<span class=\"strong\">Vanessa</span>: It sounds like you had an exciting day.</br>\n<span class=\"strong\">Sally</span>: You should join us in watching the marathon next spring.</br>\n<span class=\"strong\">Vanessa</span>: Sounds good to me.", "id": 3, "time": "32400", "image": "engenn5le15ob11re2img06.jpg"}]}}]}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Peter and Sally Plan a Road Trip"}, {"type": "unit_name", "content": "Catching Up With Vanessa"}, {"type": "position", "content": 11}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 15}, {"type": "level", "content": "A2.2"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Accurately use information about people's jobs and places of work in communicative situations."}, {"type": "secondary_1", "content": "Identifies the expressions and vocabulary necessary for the description of people and places in common written and spoken situations."}, {"type": "secondary_2", "content": "Identifies the expressions and vocabulary necessary for the description of people and places in common written and spoken situations."}, {"type": "secondary_3", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_4", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_5", "content": "Identifies the expressions and vocabulary necessary for the description of people and places in common written and spoken situations."}, {"type": "secondary_6", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_7", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_8", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}]}, {"type": "background_image", "content": "engenn5le15ob11re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Making and Responding to Requests and Asking for Advice / Permission"}, {"type": "describer", "content": "<span class=\"underline\">Making and Responding to Requests</span><br><br>When you make and respond to requests, remember to be polite!"}, {"type": "table", "content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Making Requests\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Responding to Requests\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Would you \u2026 ?</br> I'd like to \u2026</br> Would you mind (if) \u2026 ?</br> Would\u2026  be okay?</br> I was wondering if \u2026 </br>Could you \u2026 ?</br> Do you think you could \u2026 ?</br> Is there any chance you could \u2026 ?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Sure, I'll \u2026 </br>Sure, I'd be glad to \u2026 </br>No, not at all. </br>Certainly.</br> Yes, of course.</br> I'll see what I can do. </br>I don't mind at all. </br>Of course we can \u2026</br> No problem.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "text", "content": "Examples:<br><li><span class=\"strong\">Sally</span>: I was wondering if we could have coffee.</br> &nbsp; &nbsp; <span class=\"strong\">Vanessa</span>: Of course we can.</li><li><span class=\"strong\">Vanessa</span>: Do you mind if we go to my favorite espresso bar</br> &nbsp; &nbsp; <span class=\"strong\">Sally</span>: Sure. No problem.</li></ul>"}, {"type": "text", "content": "<span class=\"underline\">Asking for Advice</span><br><br> You can use <span class=\u201citalic\u201d>should</span> when asking for advice. You can also use the question <span class=\u201citalic\u201d>What should I do?</span> to ask for advice.  <br><br> Examples:<br> <ul><li>What should I do today?</li> <li>What should I bring to the party?</li> <li>How should I prepare for my interview?</li></ul> "}, {"type": "text", "content": "<span class=\"underline\">Asking for Permission</span><br><br>When you ask for permission, you often use a modal like <span class=\"italic\">can</span>, <span class=\"italic\">may</span>, <span class=\"italic\">could</span> or <span class=\"italic\">would</span>.<br> You can also ask a Yes or No question like \u201c<span class=\"italic\">Is it OK if \u2026 ?</span>\u201d or \u201c<span class=\"italic\">Do you mind \u2026 ?</span>\u201d<br> Here are some ways to ask for and give permission.<br><br>  Examples:<br> <ul><li>Can I use this pen?</li> <li>Could I work from home tomorrow?</li> <li>May I use your washroom?</li> <li>Is it OK if I leave early today?</li> <li>Do you mind if I take my lunch break before the meeting?</li></ul>"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Past Tense and Past Continuous tense"}, {"type": "describer", "content": "You use the Simple Past tense to talk about events that are finished. You use the Past Continuous to talk about events or an action that   was happening at a time in the past."}, {"type": "example", "content": "I sat through all the innings, rooted for our home team, and watched them hit some home runs."}, {"type": "example", "content": "We rode up all the hills and ventured down to the seaside."}, {"type": "example", "content": "I was drinking my beer when Peter cheered his lungs out."}, {"type": "text", "content": "Simple Past tense verbs can be regular or irregular.</br> Regular verbs end in <span class=\"italic\">-ed</span> or <span class=\"italic\">-ied</span>.</br> Irregular verbs change in different ways.</br> For questions in the past, you use the auxiliary <span class=\"italic\">did</span> followed by the verb in the base form, like <span class=\"italic\">Did you ask \u2026 ?</span></br> <span class=\"italic\">Did</span> is the past form of <span class=\"italic\">to do</span>."}, {"type": "text", "content": "For Past Continuous, we add was/were + verb \u201cing\u201d to verbs.</br> Some verbs need a change to the last letter to add \u201cing\u201d."}, {"type": "table", "content": "{\"rows\":8,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Present tense\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Past tense\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Present Continuous tense\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"cram\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"crammed\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"was/were cramming\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"rent\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"rented\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"was/were renting\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"go\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"went\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"was/were going\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"sit\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"sat\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"was/were sitting\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"ride\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"rode\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"was/were riding\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"cheer\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"cheered\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"was/were cheering\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to bum around"}, {"type": "definition", "content": "to go to various places with a friend, to hang out"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Vanessa wants to bum around with Sally for the morning."}, {"type": "audio", "content": "engenn5le15ob11aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "Placeholder"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "inning"}, {"type": "definition", "content": "One turn of a baseball game when one team is batting and the other team is catching - this goes until the batting team has 3 players out. Then they switch."}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: We sat through all 9 innings of the game."}, {"type": "audio", "content": "engenn5le15ob11aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to root for"}, {"type": "definition", "content": "to cheer on your team"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: We both rooted for the home team."}, {"type": "audio", "content": "engenn5le15ob11aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "home run"}, {"type": "definition", "content": "When a player hits a ball that no one from the other team catches, which allows him to run all the bases back to home plate. This scores the team one point."}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: We watched our home team hit some home runs."}, {"type": "audio", "content": "engenn5le15ob11aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to venture"}, {"type": "definition", "content": "to go somewhere new for the first time"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: We ventured down to the seaside on our bikes."}, {"type": "audio", "content": "engenn5le15ob11aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "marathon"}, {"type": "definition", "content": "a running race on the roads that's 26.2 miles long"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Sally wants Vanessa to join her to watch the marathon next spring."}, {"type": "audio", "content": "engenn5le15ob11aud06"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Plan a road trip with your partner to another interesting city."}, {"type": "text", "content": "Write down 3 places you can go to. Ask your partner to do the same. Make requests in English to each other. "}, {"type": "text", "content": "Write a dialogue together about the road trip. "}, {"type": "text", "content": "Talk about where you went and what you did. Be sure to use Past tense verbs."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I talk about places to go and things to do on a road trip."}, {"type": "text", "content": "I write a dialogue about a road trip."}, {"type": "text", "content": "I talk about what I was doing when something happened."}, {"type": "text", "content": "I make requests and ask permission."}]}], "type": "sena"}