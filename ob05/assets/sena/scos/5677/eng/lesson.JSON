ontents": [{"content": "engenn5le15ob05re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " Let's learn about the history of the United States. Research the history of famous sites.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}, {"content": "Listening", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "Peter and Sally Plan a Road Trip", "type": "lesson_name"}, {"content": "Faneuil Hall", "type": "unit_name"}, {"content": 5, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 15, "type": "lesson"}, {"content": "A2.2", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Accurately use information about people and places in communicative situations.", "type": "primary"}, {"content": "Identifies the expressions and vocabulary necessary for the description of people and places in common written and spoken situations. ", "type": "secondary_1"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_2"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_3"}, {"content": "Identifies the expressions and vocabulary necessary for the description of people and places in common written and spoken situations. ", "type": "secondary_4"}, {"content": "Identifies the expressions and vocabulary necessary for the description of people and places in common written and spoken situations. ", "type": "secondary_5"}, {"content": "Identifies the expressions and vocabulary necessary for the description of people and places in common written and spoken situations. ", "type": "secondary_6"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_7"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_8"}]}, {"content": "engenn5le15ob05re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Past Tense and Past Continuous tense", "type": "heading"}, {"content": "You use the Simple Past tense to talk about events that are finished.</br> You use the Past Continuous to talk about events or an action that was happening at a time in the past.", "type": "describer"}, {"content": "<span class=\"strong\">Peter</span>: My dad took me to the Public Garden at Boston Common a lot when I was younger.", "type": "example"}, {"content": "<span class=\"strong\">Peter</span>: I loved taking photos of that big old navy sailing ship as a kid.", "type": "example"}, {"content": "Simple Past tense verbs can be regular or irregular.</br> Regular verbs end in <span class=\"italic\">-ed</span> or <span class=\"italic\">-ied</span>.</br> Irregular verbs change in different ways.</br> For questions in the past, you use the auxiliary <span class=\"italic\">did</span> followed by the verb in the base form, like <span class=\"italic\">Did you ask \u2026 ?</span></br> <span class=\"italic\">Did</span> is the past form of <span class=\"italic\">to do</span>.", "type": "text"}, {"content": "For Past Continuous, we add<span class=\"italic\"> was/were + verb -ing </span>to verbs. Some verbs need a change to the last letter to add <span class=\"italic\">-ing</span>.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "beginnings", "type": "name"}, {"content": "the very beginning of something, like a country, a company or a long project", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The United States of America had its beginnings in Boston.", "type": "example"}, {"content": "engenn5le15ob05aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about places and attractions.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "to found", "type": "name"}, {"content": "the actions of starting a company or a country", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: The people who founded the country had a lot of meetings at Faneuil Hall. ", "type": "example"}, {"content": "engenn5le15ob05aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "marketplace", "type": "name"}, {"content": "a place where a lot of different vendors sell food or other products", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I love going to the marketplace to try out different kinds of food.", "type": "example"}, {"content": "engenn5le15ob05aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "constitution", "type": "name"}, {"content": "a document that describes a set of beliefs and laws by which a country is governed", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The first president named the ship USS Constitution after the important document for the country.", "type": "example"}, {"content": "engenn5le15ob05aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to take photos", "type": "name"}, {"content": "the action word used for using a camera to capture a picture", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I love to take photos of interesting places in the city.", "type": "example"}, {"content": "engenn5le15ob05aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "president", "type": "name"}, {"content": "the leader of a company or a country's government, capitalized as part of a government title", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The first President of the United States was George Washington.", "type": "example"}, {"content": "engenn5le15ob05aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "sailing ship", "type": "name"}, {"content": "a ship that uses large sails to catch wind power to move", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The USS Constitution was a large navy sailing ship.", "type": "example"}, {"content": "engenn5le15ob05aud07", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Research more into the background of Faneuil Hall and Boston Common. Do it in English.", "type": "text"}, {"content": "Look for the following information: <ul><li>What year were those places founded?</li> <li>What important events in US history took place there?</li></ul>", "type": "text"}, {"content": "Write 3 sentences for each place from the information you found.", "type": "text"}, {"content": "Share your information in English with your partner. Ask them if they understood.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I  do research in English on historical places in the US.", "type": "text"}, {"content": "I write complete statements on historical facts.", "type": "text"}, {"content": "I share my information in English.", "type": "text"}, {"content": "I listen to my partner and check for understanding.", "type": "text"}]}]}