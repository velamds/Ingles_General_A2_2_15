t": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self Assessment."}]}], "template_override": 1}], "id": 0, "type": "scholar", "stimuli": [{"_data": [], "template_override": 1, "type": "welcome", "id": 0, "contents": [{}]}, {"id": 1, "type": "audio", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn5le15ob05re2aud01", "coverimg": "engenn5le15ob05re2img05.jpg", "images": [{"text": "", "id": 0, "time": "0", "image": "engenn5le15ob05re2img05.jpg"}, {"text": "<span class=\"strong\">Sally</span>: Well, I could certainly feel the tradition and history of baseball in Fenway Park.</br>\n<span class=\"strong\">Peter</span>: This whole city is rich with history because the country had its beginnings here - even the Freedom Trail we're riding on.", "id": 1, "time": "100", "image": "engenn5le15ob05re2img05.jpg"}, {"text": "<span class=\"strong\">Sally</span>: Did your parents take you to a lot of places as a kid?</br>\n<span class=\"strong\">Peter</span>: Yeah, my dad took me to the Public Garden at Boston Common a lot. We enjoyed playing around there. It's the oldest city park in all of the U.S.A.</br>\n<span class=\"strong\">Sally</span>: And here we are at Faneuil Hall Marketplace. The country was actually founded from meetings that took place here. I was looking at all the treats when my parents went shopping for food.", "id": 2, "time": "12000", "image": "engenn5le15ob05re2img01.jpg"}, {"text": "<span class=\"strong\">Peter</span>: Yeah, Yeah, one time I was feeding the pigeons when the big clock bell struck. It scared me.</br>\n<span class=\"strong\">Sally</span>: Let's go see the U.S.S. Constitution. I loved taking photos of that big old navy sailing ship as a kid. It was named by the first president George Washington.", "id": 3, "time": "37000", "image": "engenn5le15ob05re2img03.jpg"}]}}]}, {"id": 3, "type": "text", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "audio", "value": "engenn5le15ob05re6aud04"}]}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Peter and Sally Plan a Road Trip"}, {"type": "unit_name", "content": "Faneuil Hall"}, {"type": "position", "content": 5}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 15}, {"type": "level", "content": "A2.2"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Accurately use information about people and places in communicative situations."}, {"type": "secondary_1", "content": "Identifies the expressions and vocabulary necessary for the description of people and places in common written and spoken situations. "}, {"type": "secondary_2", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_3", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_4", "content": "Identifies the expressions and vocabulary necessary for the description of people and places in common written and spoken situations. "}, {"type": "secondary_5", "content": "Identifies the expressions and vocabulary necessary for the description of people and places in common written and spoken situations. "}, {"type": "secondary_6", "content": "Identifies the expressions and vocabulary necessary for the description of people and places in common written and spoken situations. "}, {"type": "secondary_7", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_8", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}]}, {"type": "background_image", "content": "engenn5le15ob05re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Past Tense and Past Continuous tense"}, {"type": "describer", "content": "You use the Simple Past tense to talk about events that are finished.</br> You use the Past Continuous to talk about events or an action that was happening at a time in the past."}, {"type": "example", "content": "<span class=\"strong\">Peter</span>: My dad took me to the Public Garden at Boston Common a lot when I was younger."}, {"type": "example", "content": "<span class=\"strong\">Peter</span>: I loved taking photos of that big old navy sailing ship as a kid."}, {"type": "text", "content": "Simple Past tense verbs can be regular or irregular.</br> Regular verbs end in <span class=\"italic\">-ed</span> or <span class=\"italic\">-ied</span>.</br> Irregular verbs change in different ways.</br> For questions in the past, you use the auxiliary <span class=\"italic\">did</span> followed by the verb in the base form, like <span class=\"italic\">Did you ask\u2026?</span></br> <span class=\"italic\">Did</span> is the past form of <span class=\"italic\">to do</span>."}, {"type": "text", "content": "For Past Continuous, we add was/were + verb\u201cing\u201d to verbs. Some verbs need a change to the last letter to add \u201cing\u201d."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "beginnings"}, {"type": "definition", "content": "the very beginning of something, like a country, a company or a long project."}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The United States of America had its beginnings in Boston."}, {"type": "audio", "content": "engenn5le15ob05aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use to talk about places and attractions."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to found"}, {"type": "definition", "content": "the actions of starting a company or a country"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: The people who founded the country had a lot of meetings at Faneuil Hall. "}, {"type": "audio", "content": "engenn5le15ob05aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "marketplace"}, {"type": "definition", "content": "a place where a lot of different vendors sell food or other products"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I love going to the marketplace to try out different kinds of food."}, {"type": "audio", "content": "engenn5le15ob05aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "constitution"}, {"type": "definition", "content": "a document that describes a set of beliefs and laws by which a country is governed"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The first president named the ship U.S.S. Constitution after the important document for the country."}, {"type": "audio", "content": "engenn5le15ob05aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to take photos"}, {"type": "definition", "content": "the action word used for using a camera to take a photo"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I love to take photos of interesting places in the city."}, {"type": "audio", "content": "engenn5le15ob05aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "president"}, {"type": "definition", "content": "the leader of a company or a country's government"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The first president of the United States was George Washington."}, {"type": "audio", "content": "engenn5le15ob05aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "sailing ship"}, {"type": "definition", "content": "a ship that uses large sails to catch wind power to move"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The U.S.S. Constitution was a large navy sailing ship."}, {"type": "audio", "content": "engenn5le15ob05aud07"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Research more into the background of the Faneuil Hall and Boston Common. Do it in English."}, {"type": "text", "content": "Look for the following information: <ul><li>What year were those places founded?</li> <li>What important events in U.S. history took place there?</li></ul>"}, {"type": "text", "content": "Write 3 sentences for each place from the information you found."}, {"type": "text", "content": "Share your information in English with your partner. Ask them if they understood."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I research in English into historical places in the U.S."}, {"type": "text", "content": "I write complete statements on historical facts."}, {"type": "text", "content": "I share my information in English."}, {"type": "text", "content": "I listen to my partner and check for understanding."}]}], "type": "sena"}